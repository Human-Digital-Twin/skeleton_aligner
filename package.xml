<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>skeleton_aligner</name>
  <version>0.1.0</version>
  <description>ROS 2 package for real-time spatial alignment of multi-source 3D skeleton tracking
    data</description>
  <maintainer email="mattia.guidolin@unipd.it">Mattia Guidolin</maintainer>
  <maintainer email="paride.gnesotto@phd.unipd.it">Paride Gnesotto</maintainer>

  <license>Apache-2.0</license>

  <author email="mattia.guidolin@unipd.it">Mattia Guidolin</author>
  <author email="paride.gnesotto@phd.unipd.it">Paride Gnesotto</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>hiros_skeleton_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>Eigen3</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>